# Image "indicconformer" for the stt-fallback container and
# bench_indicconformer.sh: onnx-asr to run AI4Bharat's
# IndicConformer Marathi model on the CPU. The model is downloaded on first
# use into the docker volume indicconformer-cache, not baked in.
#
# Built on Immich's machine-learning image, which xero already has, because
# it brings onnxruntime, numpy and huggingface_hub: pip from xero to pypi.org
# stalls on half of its Fastly addresses (2026-11-04, again 2026-11-15), so a
# python:slim + pip build kept failing. onnx-asr is pure Python with no other
# runtime deps; build_indicconformer_image.sh downloads its wheel with curl (with
# retries) into the build context. Bump the Immich tag if its image is upgraded.
FROM ghcr.io/immich-app/immich-machine-learning:v3.4.1
COPY onnx_asr-0.12.0-py3-none-any.whl /tmp/
# the venv has no pip (uv-built); a pure-Python wheel is a zip of site-packages
RUN /opt/venv/bin/python3 -c "import zipfile, sysconfig; zipfile.ZipFile('/tmp/onnx_asr-0.12.0-py3-none-any.whl').extractall(sysconfig.get_paths()['purelib'])"
ENV PATH=/opt/venv/bin:$PATH
ENTRYPOINT []
