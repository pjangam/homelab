@startuml
' Voice assistant: every part, where it runs and what talks to what.
' Render: projects/voice-assistant/render_architecture.sh  (-> architecture.svg/.png)
title Voice assistant - architecture (2026-11-15)

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam componentStyle rectangle
skinparam ArrowColor #555555
skinparam rectangle {
  BorderColor #777777
  RoundCorner 8
}
skinparam database {
  BackgroundColor #FFF8E1
}
skinparam legend {
  BackgroundColor #FAFAFA
  BorderColor #BBBBBB
}

actor "You" as user

rectangle "Bedroom" as bedroom #E3F2FD {
  node "Voice Satellite\nESP32 + INMP441 mic\n(ESPHome)" as sat_bed
  node "wol Pi" as pi #FFFFFF {
    component "spotifyd\n(Connect: raspberrypi)" as spd_pi
    component "volume-mqtt\n(Pi Speaker Volume)" as vol_pi
  }
  rectangle "3.5mm jack speaker" as spk_pi
}

rectangle "Living room" as living #E8F5E9 {
  node "Voice Living Room\nESP32 + INMP441 mic\n(ESPHome)" as sat_liv
  rectangle "Bluetooth speaker" as spk_xero
}

node "xero (N5105 server)" as xero #F3E5F5 {
  rectangle "Docker" as docker #FFFFFF {
    component "Home Assistant" as ha #FFFDE7 {
      component "Assist pipeline\n(wake -> STT -> intent -> TTS)" as pipeline
      component "voice_commands.yaml\nAC / fans / turn off everything\nSpotify pause, next, volume" as cmds
      component "voice_play_song\n(spotify_songs.yaml)\nplay {song} -> track URI\nroom -> speaker" as playsong
      component "Spotify integration\nmedia_player.spotify_pramod" as spint
      component "Spotcast\nplay_media on a device" as spotcast
      component "Built-in intents\nturn on/off <name>" as builtin
    }
    component "wake-proxy :10400 ->\nopenwakeword :10401\nHey Jarvis | Dumbledore" as oww
    component "stt-fallback\n:10300\nWyoming proxy" as fb
    component "speech-to-phrase\n:10301\nKaldi, closed vocabulary" as stp
    component "IndicConformer\n(Marathi, in stt-fallback)\nonly when stp hears nothing" as indic
    component "piper\n:10200\nspoken replies" as piper
    component "mosquitto\nMQTT :1883" as mqtt
    database "stp-models\nRhasspy en_US Kaldi\n(2021, 127MB)" as stpmodels
    database "stp-train\nphrase graph HCLG.fst\n(rebuilt on restart)" as stptrain
  }
  rectangle "Host (cron, systemd --user)" as host #FFFFFF {
    component "spotify_library.py\nvia sync_spotify_songs.sh\ncron 04:30" as lib
    component "healthcheck.sh -> check_stt.sh\nevery 15 min" as hc
    component "spotifyd\n(Connect: xero)" as spd_xero
    component "volume-mqtt\n(xero Speaker Volume)" as vol_xero
  }
  folder "repo: projects/voice-assistant" as repo {
    file "custom_sentences/en/\nsentences.yaml (lists)\nsongs.yaml (generated)" as cs
    file "packages/\nvoice_commands.yaml\nspotify_songs.yaml (generated)" as pkgs
  }
}

cloud "Spotify" as spotify {
  component "Web API\nliked songs, playlists,\nplayback control" as spapi
}

' Colours: black = every command, in order 1-6 | orange = exactly ONE of
' these per command (which one depends on the words; see intent_routing.puml)
' | blue = music | grey dotted = setup / training, not per command | green = volume sliders.
' <--> = request and its answer; --> = one way.

' --- every command, in order ---
user -[#000000]-> sat_bed : "Hey Jarvis,\nplay faint"
user -[#000000]-> sat_liv
sat_bed -[#000000,bold]-> pipeline : 1. mic audio, streamed\nall the time (ESPHome API)
sat_liv -[#000000,bold]-> pipeline
pipeline <-[#000000,bold]-> oww : 2. audio frames /\n"wake word heard"
pipeline <-[#000000,bold]-> fb : 3. audio clip /\ntext (or "")
fb <-[#000000,bold]-> stp : 3a. same audio /\ntext (or "")
fb <-[#6A1B9A]-> indic : 3b. only if "":\nDevanagari -> one of\nour songs, or nothing
pipeline <-[#000000,bold]-> piper : 5. reply text /\nspeech audio
pipeline .[#000000].> sat_bed : 6. reply audio URL\n(satellite has no speaker:\ndropped; phone app plays it)

' --- step 4: exactly one handler per command ---
pipeline <-[#E65100,bold]-> playsong : 4a. "play {song}" /\nreply text
pipeline <-[#E65100,bold]-> cmds : 4b. custom sentence /\nreply text
pipeline <-[#E65100,bold]-> builtin : 4c. built-in sentence /\nreply text

' --- music ---
playsong -[#1565C0]-> spotcast : track URI +\nPi (bedroom) or xero
cmds -[#1565C0]-> spint : pause / next / volume
spotcast -[#1565C0]-> spapi
spint -[#1565C0]-> spapi
spapi -[#1565C0]-> spd_pi : play on device
spapi -[#1565C0]-> spd_xero
spd_pi -[#1565C0]-> spk_pi
spd_xero -[#1565C0]-> spk_xero

' --- setup and training (not per command) ---
stp .[#888888].> stpmodels : acoustic model
stp .[#888888].> stptrain : trained phrases
lib .[#888888].> spapi : read library\n(HA's Spotify token)
lib .[#888888].> cs : writes songs.yaml
lib .[#888888].> pkgs : writes spotify_songs.yaml
lib .[#888888].> ha : reload automations
lib .[#888888].> stp : restart = retrain
pkgs .[#888888].> ha : bind mount\n/config/packages
cs .[#888888].> stp : bind mount\n/custom_sentences
stp .[#888888].> ha : reads sentence triggers\nat training (websocket)
hc .[#888888].> stp : test phrase; restart\nif custom commands deaf

' --- volume sliders ---
vol_pi -[#2E7D32]-> mqtt
vol_xero -[#2E7D32]-> mqtt
mqtt -[#2E7D32]-> ha : number.* sliders

legend right
  |= Arrow |= Meaning |
  | <color:#000000>**black, numbered**</color> | every command, steps 1-6 in order |
  | <color:#E65100>**orange 4a/4b/4c**</color> | step 4: exactly **one** of these per command\n(which one: intent_routing diagram) |
  | <color:#1565C0>**blue**</color> | music, after 4a or 4b |
  | <color:#2E7D32>**green**</color> | volume sliders (MQTT) |
  | <color:#888888>**grey dotted**</color> | setup / nightly training, not per command |
  | <color:#6A1B9A>**purple 3b**</color> | Marathi fallback: only when speech-to-phrase hears nothing |
  | <-> | request and its answer |
  | -> | one way |
  Wake word and speech-to-text run on xero,
  not the satellite (original ESP32, no on-device wake word).
endlegend
@enduml
