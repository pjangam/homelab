*/5 * * * * /home/pramod/code/homelab/projects/spotifyd/watchdog_spotifyd.sh >> /home/pramod/code/homelab/spotifyd-watchdog.log 2>&1
5 11 * * * /home/pramod/code/homelab/projects/miraie-ac/renew_miraie_login.sh >> /home/pramod/code/homelab/miraie-login-renew.log 2>&1
30 3 * * * /home/pramod/code/homelab/projects/certs-backup/backup_hardware_md.sh >> /home/pramod/code/homelab/backup.log 2>&1
45 3 * * * /home/pramod/code/homelab/projects/certs-backup/backup_documents.sh >> /home/pramod/code/homelab/backup.log 2>&1
* * * * * /home/pramod/code/homelab/services/node-exporter/zpool_textfile.sh >> /home/pramod/code/homelab/zpool-textfile.log 2>&1
