{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AddObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts", "s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/immich/*"
    },
    {
      "Sid": "ListForSizeCheck",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {"StringLike": {"s3:prefix": ["immich", "immich/*"]}}
    }
  ]
}
