[Unit]
Description=Brown Noise Player
After=sound.target

[Service]
# The mixer the fade and the level act on, the level itself and the stop fade's
# steps. These are xero's USB speaker, where 59% is ~67 dB at the bed (measured
# 2026-09-24); the wol Pi overrides all four in white-noise.service.d/host.conf.
# systemd fills in the braced ${...} even inside the bash -c string below; the
# unbraced $v there is left alone for bash.
Environment=ALSA_CARD=1 ALSA_CONTROL=Speaker WHITE_NOISE_LEVEL=59
Environment="WHITE_NOISE_FADE=45 32 18 5"
ExecStartPre=/usr/bin/amixer -c ${ALSA_CARD} sset ${ALSA_CONTROL} ${WHITE_NOISE_LEVEL}%
# Pause Spotify, so starting white noise never plays over music. The `-` keeps
# a start from failing when there is nothing to pause: spotifyd only publishes
# its MPRIS player while a Connect session is active, and otherwise playerctl
# logs "No players found" - expected, not a fault.
ExecStartPre=-/usr/bin/playerctl -p spotifyd pause
ExecStart=/usr/bin/play -n -q synth brownnoise fade t 60
ExecStop=/bin/bash -c 'for v in ${WHITE_NOISE_FADE}; do amixer -c ${ALSA_CARD} sset ${ALSA_CONTROL} "$v%" >/dev/null; sleep 0.3; done; kill $MAINPID 2>/dev/null; sleep 0.3; amixer -c ${ALSA_CARD} sset ${ALSA_CONTROL} ${WHITE_NOISE_LEVEL}% >/dev/null'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
