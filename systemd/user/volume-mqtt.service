[Unit]
Description=Volume MQTT Bridge
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/home/pramod/code/homelab/.env.mqtt
ExecStart=%h/.local/bin/uv run --script /home/pramod/code/homelab/scripts/volume-mqtt.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
