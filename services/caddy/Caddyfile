{
    auto_https off
}

xero.{$TAILNET_SUFFIX} {
    tls /certs/xero.{$TAILNET_SUFFIX}.crt /certs/xero.{$TAILNET_SUFFIX}.key

    # projects-ui dashboard (see docker-compose.yml) - handle picks the
    # first matching block, so this must come before the catch-all below.
    # Path kept intact (not stripped) since projects-ui's own nginx.conf
    # serves it under a matching /projects/ location.
    @projects path /projects /projects/*
    handle @projects {
        reverse_proxy localhost:8125
    }

    # clawlight status light (see clawlight/README.md) - path kept intact since
    # clawlight/server.py routes on the /clawlight prefix itself, same reasoning
    # as the /projects block above.
    @clawlight path /clawlight /clawlight/*
    handle @clawlight {
        reverse_proxy localhost:8126
    }

    # Endpoint index (see projects/endpoints/README.md) - the only handle here
    # served off disk rather than proxied. The rendered site/ is bind-mounted
    # read-only into the caddy container (see docker-compose.yml); it is
    # generated by render_endpoints.py and is NOT in git, because it carries
    # the tailnet suffix that endpoints.toml deliberately leaves as a
    # placeholder. If this 404s, the render has not been run on this machine.
    #
    # uri strip_prefix, unlike the two blocks above: there is no app behind
    # this one to route on the prefix itself, just an index.html on disk.
    @endpoints path /endpoints /endpoints/*
    handle @endpoints {
        # Without this, /endpoints strips to an empty path and file_server has
        # no "/" to resolve index.html against. Same redirect projects-ui's
        # nginx.conf does for /projects, for the same reason.
        redir /endpoints /endpoints/
        uri strip_prefix /endpoints
        root * /srv/endpoints
        file_server
    }

    handle {
        reverse_proxy localhost:8080
    }
}

