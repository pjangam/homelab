      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((node_thermal_zone_temp{type=~\"x86_pkg_temp|cpu-thermal\"})[$__interval:5s])",
          "legendFormat": "{{host}} max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
