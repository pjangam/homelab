{
  "uid": "hosts",
  "title": "Hosts",
  "description": "xero and the wol Pi: max and p95 of 5s samples, never averages.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU busy, all cores",
      "description": "Share of all cores busy (not idle, not iowait) per 5s; each point is the max / p95 of its interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((100 * (1 - sum by (host) (irate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[30s])) / count by (host) (node_cpu_seconds_total{mode=\"idle\"})))[$__interval:5s])",
          "legendFormat": "{{host}} max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, (100 * (1 - sum by (host) (irate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[30s])) / count by (host) (node_cpu_seconds_total{mode=\"idle\"})))[$__interval:5s])",
          "legendFormat": "{{host}} p95"
        }
      ]
    },
