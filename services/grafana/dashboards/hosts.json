    {
      "id": 12,
      "type": "timeseries",
      "title": "SSD used",
      "description": "xero's two SSDs. Kingston = the whole ZFS pool incl. snapshots, from `zfs list` (services/node-exporter/zpool_textfile.sh, cron every minute); 100% is when writes stop. Its datasets are copies=2, so each GB of new data costs 2 GB here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
