{
  "uid": "hosts",
  "title": "Hosts",
  "description": "xero and the wol Pi: max and p95 of 5s samples, never averages.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "description": "Since each host's kernel booted (node_boot_time_seconds), so a container or HA restart does not reset it. A clean shutdown on a power cut (projects/power-watchdog) does.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reboots in range",
      "description": "How many times the boot time changed within the selected range. Prometheus keeps 90 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "changes(node_boot_time_seconds[$__range])",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU busy, all cores",
      "description": "Share of all cores busy (not idle, not iowait) per 5s; each point is the max / p95 of its interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "$res",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((100 * (1 - sum by (host) (irate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[30s])) / count by (host) (node_cpu_seconds_total{mode=\"idle\"})))[$__interval:5s])",
          "legendFormat": "{{host}} max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, (100 * (1 - sum by (host) (irate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[30s])) / count by (host) (node_cpu_seconds_total{mode=\"idle\"})))[$__interval:5s])",
          "legendFormat": "{{host}} p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU temperature",
      "description": "xero: x86_pkg_temp (N5105 TjMax 105\u00b0C; healthcheck warns at 90, the Immich load guard stops it at 93). Pi: cpu-thermal.",
