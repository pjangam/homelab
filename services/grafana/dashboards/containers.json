      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((sum by (name) (irate(container_network_receive_bytes_total{name!=\"\"}[30s])))[$__interval:5s])",
          "legendFormat": "{{name}} rx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max_over_time((sum by (name) (irate(container_network_transmit_bytes_total{name!=\"\"}[30s])))[$__interval:5s])",
          "legendFormat": "{{name}} tx"
        }
      ]
    }
  ],
  "editable": true
}
