          },
          "refId": "A",
          "expr": "max_over_time((container_memory_working_set_bytes{name!=\"\"})[$__interval:5s])",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Container network (max)",
      "description": "Host-networked containers (Caddy, Grafana, Prometheus, HA...) do not show here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
