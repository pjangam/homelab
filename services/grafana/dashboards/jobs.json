{
  "uid": "jobs",
  "title": "Jobs",
  "description": "Every scheduled job on xero (and later the Pi): last run, next run, result, cost and temperatures. Source: projects/jobs-dashboard.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 27,
      "type": "table",
      "title": "Jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "One row per job, latest finished run. Schedules and commands: projects/jobs-dashboard/jobs.toml. Output: the log file, or journalctl --user -u job-<name>.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OK"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last start"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 (60d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max (60d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Next run"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fails in a row"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Max CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Peak memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU \u00b0C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kingston \u00b0C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Runs (60d)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OK"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "ok",
                        "color": "green"
                      },
                      "0": {
                        "text": "FAILED",
                        "color": "red"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "not run yet",
                        "color": "transparent"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fails in a row"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "OK",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "Z",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name, desc, schedule, log) (homelab_job_info{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_ok{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_start_timestamp_seconds{name=~\"$jobname\"}) * 1000"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_duration_seconds{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_duration_p95_seconds{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_duration_max_seconds{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_next_run_timestamp_seconds{name=~\"$jobname\"}) * 1000"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_consecutive_failures{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_cpu_max_percent{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_memory_peak_bytes{name=~\"$jobname\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "K",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_peak_temp_celsius{name=~\"$jobname\",sensor=\"cpu\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "L",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_last_peak_temp_celsius{name=~\"$jobname\",sensor=\"ssd_data\"})"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "M",
          "instant": true,
          "range": false,
          "format": "table",
          "expr": "max by (host, name) (homelab_job_runs{name=~\"$jobname\"})"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #Z": true
            },
            "indexByName": {
              "host": 0,
              "name": 1,
              "desc": 2,
              "schedule": 3
            },
            "renameByName": {
              "Value #A": "OK",
              "Value #B": "Last start",
              "Value #C": "Duration",
              "Value #D": "p95 (60d)",
              "Value #E": "Max (60d)",
              "Value #F": "Next run",
              "Value #G": "Fails in a row",
              "Value #H": "Max CPU",
              "Value #I": "Peak memory",
              "Value #K": "CPU \u00b0C",
              "Value #L": "Kingston \u00b0C",
              "Value #M": "Runs (60d)",
              "name": "Job",
              "host": "Host",
              "desc": "What it does",
              "schedule": "Schedule",
              "log": "Log"
            }
          }
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Duration of each run",
      "description": "Steps to each run's duration when it finishes. Runs shorter than the gap between points can be missed when zoomed out; the table's p95/max cannot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "$res",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (host, name) (homelab_job_last_duration_seconds{name=~\"$jobname\"})",
          "legendFormat": "{{host}} {{name}}"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Failures in a row",
      "description": "0 while the job succeeds; climbs by one per failed run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "$res",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (host, name) (homelab_job_consecutive_failures{name=~\"$jobname\"})",
          "legendFormat": "{{host}} {{name}}"
        }
      ]
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "CPU temperature (jobs shaded while running)",
      "description": "Shaded: a job that has been running for more than 10s (shorter runs cannot move a temperature).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "$res",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((max by (host) (node_hwmon_temp_celsius{chip=~\"platform_coretemp.*\"}))[$__interval:5s])",
          "legendFormat": "{{host}} max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "quantile_over_time(0.95, (max by (host) (node_hwmon_temp_celsius{chip=~\"platform_coretemp.*\"}))[$__interval:5s])",
          "legendFormat": "{{host}} p95"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "SSD temperature (jobs shaded while running)",
      "description": "The Kingston is rated to 70\u00b0C. Shaded regions: a job was running.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "$res",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*p95.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max",
            "lastNotNull"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc",
          "hideZeros": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max_over_time((node_hwmon_temp_celsius{host=\"xero\",chip=\"target0:0:0_0:0:0:0\"})[$__interval:5s])",
          "legendFormat": "Kingston (datapool) max"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max_over_time((node_hwmon_temp_celsius{host=\"xero\",chip=\"target1:0:0_1:0:0:0\"})[$__interval:5s])",
          "legendFormat": "BIWIN (boot) max"
        }
      ]
    }
  ],
  "editable": true,
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "res",
        "label": "Resolution",
        "query": "5s,1m,5m,15m,1h",
        "current": {
          "text": "5s",
          "value": "5s"
        },
        "options": [
          {
            "text": "5s",
            "value": "5s",
            "selected": true
          },
          {
            "text": "1m",
            "value": "1m",
            "selected": false
          },
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      },
      {
        "type": "query",
        "name": "jobname",
        "label": "Job",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_job_info, name)",
          "refId": "J"
        },
        "definition": "label_values(homelab_job_info, name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "name": "Jobs running",
        "iconColor": "rgba(255, 152, 48, 0.4)",
        "expr": "max by (name) (homelab_job_running{name=~\"$jobname\"} == 1 and (time() - homelab_job_last_start_timestamp_seconds) > 10)",
        "step": "5s",
        "titleFormat": "{{name}}",
        "textFormat": "running",
        "useValueForTime": false
      }
    ]
  }
}
